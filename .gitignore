# Local dependencies and package-manager logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python integration-test environments and bytecode
.venv/
__pycache__/
*.py[cod]

# Generated extension packages and test reports
web-ext-artifacts/
*.xpi
coverage/
.nyc_output/
playwright-report/
